{
  "name": "@wadeck-app/violations-cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "violations": "./dist-bundle/violations.cjs"
  },
  "scripts": {
    "build": "tsc && npx tsx scripts/bundle.ts",
    "bundle": "npx tsx scripts/bundle.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/**/*.test.js",
    "clean": "rimraf dist dist-bundle",
    "preversion": "node -e \"if (!process.env.CI) { process.exit(1); }\""
  },
  "files": [
    "dist/",
    "dist-bundle/"
  ],
  "publishConfig": {
    "@wadeck-app:registry": "https://npm.pkg.github.com/",
    "access": "public"
  },
  "peerDependencies": {
    "@wadeck-app/violations-rules": "*"
  },
  "dependencies": {
    "@wadeck-app/shared-cli": "latest",
    "@wadeck-app/shared-updater": "latest",
    "picomatch": "^2.3.2",
    "typescript": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/picomatch": "^2.3.4",
    "@wadeck-app/violations-rules": "*",
    "esbuild": "^0.25.0",
    "tsx": "^4.0.0"
  }
}
