{
  "name": "@wadeck/violations-cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "violations": "./dist-bundle/violations.cjs"
  },
  "scripts": {
    "build": "tsc && npx tsx scripts/bundle.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/**/*.test.js",
    "clean": "rimraf dist dist-bundle",
    "preversion": "node -e \"if (!process.env.CI) { process.exit(1); }\""
  },
  "files": [
    "dist/",
    "dist-bundle/"
