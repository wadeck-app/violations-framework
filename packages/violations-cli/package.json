  },
  "dependencies": {
    "@wadeck/shared-cli": "^2026.8.23-006-2d3e15d6",
    "micromatch": "^4.0.8",
    "typescript": "^5.5.0"
  },
  "devDependencies": {
    "@types/micromatch": "^4.0.9",
    "@types/node": "^22.0.0",
    "@wadeck/violations-rules": "*",
    "esbuild": "^0.25.0",
    "tsx": "^4.0.0"
  }
}
